grafana:
  # Высокий приоритет: мониторинг не должен вытесняться apps-нагрузкой стенда.
  priorityClassName: vmks-critical
  ingress:
    ingressClassName: nginx
    enabled: true
    annotations:
      nginx.ingress.kubernetes.io/ssl-redirect: "false"
    hosts:
      - grafana.${ingress_public_ip}.sslip.io

defaultDatasources:
  victoriametrics:
    datasources:
      - name: VictoriaMetrics
        type: prometheus
        access: proxy
        isDefault: true
        jsonData:
          httpMethod: POST
          queryTimeout: 300s
          # Снижает число точек на панель и нагрузку параллельных подзапросов к backend на широких диапазонах.
          timeInterval: 30s

defaultRules:
  groups:
    etcd:
      enabled: false
    kubernetes-system-scheduler:
      enabled: false
    kubernetes-system-controller-manager:
      enabled: false
    # В Yandex Managed K8s kube-scheduler недоступен для скрейпинга,
    # поэтому recording-правила группы kube-scheduler.rules не имеют данных
    # и порождают шумный алерт RecordingRulesNoData.
    kube-scheduler.rules:
      enabled: false
# Control-plane компоненты Yandex Managed K8s (kube-controller-manager, kube-scheduler,
# kube-etcd) недоступны для скрейпинга — master управляемый и вне кластера.
# Отключаем scrape-job, иначе vmagent плодит ScrapePoolHasNoTargets,
# а vmalert — RecordingRulesNoData для пустых scrape-pool.
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeEtcd:
  enabled: false

vmsingle:
  enabled: false

vmcluster:
  enabled: true
  spec:
    # replicationFactor — число копий каждой точки при записи (не число vmstorage).
    # Здесь RF=3 и N=3 vmstorage: каждая точка пишется на 3 ноды, потеря 1 ноды оставляет
    # кворум записи 2/3 — данные доступны и продолжают писаться. Потеря 2 нод = потеря
    # кворума и данных. Компромисс: +объём хранения (каждая точка хранится в RF копиях).
    replicationFactor: 3

    vmstorage:
      # Иначе оператор подмешивает свои значения CPU по умолчанию поверх requests из values.
      useDefaultResources: false
      # Высокий приоритет: мониторинг не должен вытесняться apps-нагрузкой стенда.
      priorityClassName: vmks-critical
      replicaCount: 3
      podDisruptionBudget:
        minAvailable: 2
      # Распределяем 3 реплики по зонам, чтобы одна AZ не собрала все stateful-поды.
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: vmstorage
      storage:
        volumeClaimTemplate:
          spec:
            storageClassName: yc-network-ssd
            accessModes: ["ReadWriteOnce"]
            resources:
              requests:
                storage: 20Gi
      # Поиск выполняется на vmstorage; дефолт maxConcurrentRequests=2 даёт 429 «couldn't start executing in 10s»
      # при параллельных запросах от vmselect/vmalert (см. также vmselect.extraArgs).
      extraArgs:
        search.maxConcurrentRequests: "32"
        search.maxQueueDuration: "60s"
        # С v1.105.0 лимит вычисляется автоматически и может быть слишком мал при 16 concurrent + 4Gi;
        # фиксируем явно, чтобы запросы вроде topk(5, sum(vmalert_alerts_firing{…}) by(…)) не падали с 422.
        # vmalert_alerting_rules_last_evaluation_samples — по ряду на правило; при >1M правил 1M мало (422 TooManyTimeseries).
        search.maxUniqueTimeseries: "5000000"
        # Дедупликация дубликатов семплов от 2 реплик vmagent (HA-репликация, не sharding).
        # 20s = vmagent.spec.scrapeInterval (явно зафиксирован в этом файле).
        # При изменении scrapeInterval — синхронно менять здесь и в vmselect.extraArgs.
        dedup.minScrapeInterval: 20s
      # Memory: при 50000 ALERTS пик container_memory_working_set_bytes ~3106Mi (линейно ~57,8 MiB / 1000 ALERTS).
      # 4Gi (4096Mi) покрывали пик с небольшим остатком, но при росте за 50k ALERTS лимит исчерпывается
      # (~70k ALERTS → ~4Gi). Поднимаем до 5Gi без production-запаса — только под измеренный профиль теста.
      # CPU: пик ~458m при limits 3 — запас 6x, без изменений.
      resources:
        limits:
          cpu: "3"
          memory: 5Gi
        requests:
          cpu: 500m
          memory: 1Gi

    vmselect:
      useDefaultResources: false
      priorityClassName: vmks-critical
      replicaCount: 3
      podDisruptionBudget:
        minAvailable: 2
      # Распределяем 3 реплики по зонам (vmselect stateless, но запросы
      # расходятся по всем storage-нодам — изолируем AZ для устойчивости).
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: vmselect
      # При большом числе VMRule vmalert шлёт много запросов (restore ALERTS_FOR_STATE + eval).
      # Дефолт maxConcurrentRequests=2 даёт 429 и "couldn't start executing in 10s".
      extraArgs:
        search.maxConcurrentRequests: "32"
        search.maxQueueDuration: "60s"
        # Согласовать с queryTimeout в defaultDatasources (иначе vmselect обрежет раньше Grafana).
        search.maxQueryDuration: 300s
        search.maxLabelsAPIDuration: 120s
        # Согласовать с vmstorage: иначе тяжёлые запросы по vmalert_* могут резаться на одном из слоёв.
        search.maxUniqueTimeseries: "5000000"
        # Даём тяжёлым панелям больше CPU-воркеров на один запрос.
        search.maxWorkersPerQuery: "8"
        # Дедупликация (согласовано с vmstorage.extraArgs.dedup.minScrapeInterval).
        # 20s = vmagent.spec.scrapeInterval (явно зафиксирован в этом файле).
        dedup.minScrapeInterval: 20s
      # 4Gi давало OOMKilled (Exit 137) при тяжёлых параллельных подзапросах vmalert к vmstorage
      # (sum(increase(vmalert_alerting_rules_errors_total[5m])) without(id) > 0 —
      # десятки параллельных запросов по каждому app-N держат промежуточные ряды в памяти).
      resources:
        limits:
          cpu: "3"
          memory: 8Gi
        requests:
          cpu: 500m
          memory: 1Gi
    vminsert:
      priorityClassName: vmks-critical
      replicaCount: 2
      podDisruptionBudget:
        minAvailable: 1
      # Распределяем 2 реплики по зонам, чтобы ingress-трафик remote-write не падал целиком в одну AZ.
      topologySpreadConstraints:
        - maxSkew: 1
          topologyKey: topology.kubernetes.io/zone
          whenUnsatisfiable: ScheduleAnyway
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: vminsert
      # CPU: при limits 500m был rate(container_cpu_cfs_throttled_seconds_total) ~0.08–0.11 с/с;
      # пиковый rate(usage[1m]) ~0.17 ядра — запас на всплески remote write.
      resources:
        limits:
          memory: 1Gi
          cpu: "1"
        requests:
          memory: 256Mi
          cpu: 100m

  ingress:
    select:
      enabled: true
      ingressClassName: nginx
      annotations:
        nginx.ingress.kubernetes.io/ssl-redirect: "false"
      hosts:
        - vmselect.${ingress_public_ip}.sslip.io

prometheus-node-exporter:
  # Высокий приоритет: DaemonSet node-exporter не должен вытесняться apps-нагрузкой стенда
  # (без этого на нодах с maxPods=110 он уходил в Pending: «Too many pods»).
  priorityClassName: vmks-critical

alertmanager:
  spec:
    priorityClassName: vmks-critical
    replicaCount: 2
    podDisruptionBudget:
      minAvailable: 1
    # Persistence для кластерного состояния (silences, notification log).
    # Без PV состояние silences теряется при рестарте/пересоздании подов —
    # добавляем volumeClaimTemplate, чтобы Alertmanager переживал рестарты.
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: yc-network-ssd
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 1Gi

    # Больше CPU: при лимите ~1 ядро наблюдался CFS throttling (container_cpu_cfs_throttled_seconds_total).
    resources:
      limits:
        cpu: "2"
        memory: 1536Mi
      requests:
        cpu: 200m
        memory: 128Mi

kube-state-metrics:
  # Высокий приоритет: мониторинг не должен вытесняться apps-нагрузкой стенда.
  priorityClassName: vmks-critical

vmalert:
  spec:
    priorityClassName: vmks-critical
    replicaCount: 2
    # Снижаем давление на vmselect от >1000 VMRule и улучшаем отзывчивость Grafana.
    evaluationInterval: "1m"
    podDisruptionBudget:
      minAvailable: 1

    # CPU: по VictoriaMetrics (cadvisor) max_over_time(rate(usage[1m])[30m]) до ~3.35 ядер/под;
    # при limits 4–5 всё ещё был rate(container_cpu_cfs_throttled_seconds_total) > 0 на нагруженных подах.
    # limits 6 + requests 4 (было 3): при ~113% от request подняли гарантию под фактическую оценку правил.
    # Memory: 5Gi давало OOMKilled (Exit 137) — после рестарта vmalert восстанавливает тысячи состояний
    # алертов (ExtraAlert0xx restored to state) для ~1350 app × несколько правил → рост памяти → OOM.
    resources:
      limits:
        cpu: "6"
        memory: 8Gi
      requests:
        cpu: 500m
        memory: 2Gi

vmagent:
  spec:
    priorityClassName: vmks-critical
    replicaCount: 2
    # Явно фиксируем scrapeInterval (совпадает с дефолтом chart'а 20s),
    # чтобы dedup.minScrapeInterval в vmstorage/vmselect всегда был согласован
    # с фактическим интервалом скрейпинга, а не зависел от тишины chart-default.
    scrapeInterval: 20s
    podDisruptionBudget:
      minAvailable: 1
    extraArgs:
      promscrape.maxScrapeSize: "134217728"
    # 768Mi давало OOMKilled: kubernetes_sd + сотни/тысячи целей держат метаданные в памяти.
    resources:
      limits:
        cpu: "2"
        memory: 3Gi
      requests:
        cpu: 250m
        memory: 512Mi

victoria-metrics-operator:
  priorityClassName: vmks-critical
  # Отказоустойчивость: leader election включён в шаблоне чарта (--leader-elect),
  # активен один pod, второй работает в режиме ожидания и берёт управление при сбое.
  replicaCount: 2
  # PDB защищает от вытеснения обоих pod'ов одновременно при maintenance (drain).
  podDisruptionBudget:
    enabled: true
    minAvailable: 1
  # Memory: 2Gi давало OOMKilled (Exit 137) — оператор держит in-memory кэш client-go
  # для ~1350 namespace × CRD (15+ контроллеров с worker count: 15 каждый).
  resources:
    limits:
      cpu: "2"
      memory: 4Gi
    requests:
      cpu: 250m
      memory: 1Gi
