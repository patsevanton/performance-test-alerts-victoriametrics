# VictoriaLogs cluster — хранилище логов (LogsQL).
# Требование: VictoriaMetrics K8s Stack установлен первым (CRD VMServiceScrape).

vlselect:
  vmServiceScrape:
    enabled: true
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 300m
      memory: 512Mi
  ingress:
    enabled: true
    ingressClassName: nginx
    annotations:
      nginx.ingress.kubernetes.io/ssl-redirect: "false"
    hosts:
      - name: victorialogs.${ingress_public_ip}.sslip.io
        path:
          - /
        port: http

vlinsert:
  vmServiceScrape:
    enabled: true
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 300m
      memory: 512Mi

vlstorage:
  vmServiceScrape:
    enabled: true
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: 500m
      memory: 1Gi
  retentionPeriod: 1d
  persistentVolume:
    size: 20Gi
